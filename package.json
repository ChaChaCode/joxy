{
  "name": "joxy",
  "productName": "JOXY",
  "version": "0.6.20",
  "private": true,
  "description": "An independent Windows proxy client powered by Xray",
  "author": "ChaChaCode",
  "license": "MIT",
  "repository": "github:ChaChaCode/joxy",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/launch.mjs",
    "test": "node --test tests/*.test.mjs",
    "fetch:core": "node scripts/fetch-core.mjs",
    "build:guard": "cd guard && go test ./... && go build -trimpath -ldflags \"-s -w\" -o ../resources/guard/joxy-guard.exe .",
    "pack": "npm run build && npm run build:guard && electron-builder --win portable --x64",
    "verify:ui": "node scripts/verify-ui.mjs",
    "shots": "node scripts/shots.mjs artifacts/design-0.6.3",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:proxy": "node scripts/verify-proxy.mjs",
    "verify:desktop": "node scripts/verify-desktop.mjs",
    "verify:tun": "node scripts/verify-tun.mjs",
    "verify:settings": "node scripts/verify-settings-desktop.mjs"
  },
  "dependencies": {
    "https-proxy-agent": "7.0.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "app.joxy.desktop",
    "productName": "JOXY",
    "artifactName": "JOXY-${version}-Windows-x64.${ext}",
    "directories": {
      "output": "release-joxy-0.6.20"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "resources/xray",
        "to": "xray",
        "filter": [
          "xray.exe",
          "LICENSE",
          "manifest.json",
          "wintun.dll",
          "LICENSE-Wintun"
        ]
      },
      {
        "from": "resources/windows-proxy.ps1",
        "to": "windows-proxy.ps1"
      },
      {
        "from": "resources/window-icon.png",
        "to": "window-icon.png"
      },
      {
        "from": "resources/window-icon.ico",
        "to": "window-icon.ico"
      },
      {
        "from": "resources/guard/joxy-guard.exe",
        "to": "guard/joxy-guard.exe"
      },
      {
        "from": "resources/windows-tun.ps1",
        "to": "windows-tun.ps1"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "resources/window-icon.ico",
      "signExecutable": false
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
